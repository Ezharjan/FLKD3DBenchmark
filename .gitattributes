# Normalize all text files to LF on checkout.
* text=auto eol=lf

# Scripts must be LF regardless of the committer's OS, otherwise bash fails
# with: $'\r': command not found / set: invalid option.
*.sh   text eol=lf
*.py   text eol=lf
*.lua  text eol=lf
*.cff  text eol=lf

# Binary / data blobs: never touch line endings.
*.ply  binary
*.obj  binary
*.h5   binary
*.dat  binary
*.png  binary
*.pdf  binary
